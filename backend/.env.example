# ==============================================================================
# CloudLib Backend Environment Configuration Template
# ==============================================================================
NODE_ENV=production
PORT=4000

# PostgreSQL / AWS RDS Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_random_string
JWT_EXPIRE=5d
COOKIE_EXPIRE=5

# AWS Configuration & S3 Bucket
AWS_REGION=eu-north-1
S3_UPLOAD_BUCKET=your-cloudlib-uploads-bucket-name
AWS_BACKEND_SECRET_ID=cloudlib/backend/env

# Frontend / CORS
FRONTEND_URL=
BACKEND_URL=
CORS_ORIGIN=

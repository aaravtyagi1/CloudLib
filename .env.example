# ==============================================================================
# CloudLib Backend Environment Configuration Template
# ==============================================================================
# Use this template to create your production or local environment configuration.
# DO NOT commit real secrets, passwords, or AWS keys to source control.
# In AWS production, these values are retrieved securely from AWS Secrets Manager
# (Secret ID: cloudlib/backend/env) using the EC2 IAM Instance Role (CloudLib-EC2-Role).
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# POSTGRESQL / AWS RDS DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/DATABASE?schema=public
# Local Example: postgresql://postgres:password@localhost:5432/ecommerce?schema=public
# AWS RDS Example: postgresql://cloudlib_admin:YOUR_PASSWORD@cloudlib-db.c123456789.eu-north-1.rds.amazonaws.com:5432/cloudlib?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION & COOKIES
# ------------------------------------------------------------------------------
# Strong 256-bit secret string for signing JWT tokens
JWT_SECRET=your_jwt_secret_min_32_characters_random_string
JWT_EXPIRE=5d
COOKIE_EXPIRE=5

# ------------------------------------------------------------------------------
# AWS CONFIGURATION & S3 FILE STORAGE
# ------------------------------------------------------------------------------
# AWS Region where your RDS, S3, and EC2 resources reside
AWS_REGION=eu-north-1

# Private Amazon S3 bucket name for product images and user avatars
S3_UPLOAD_BUCKET=your-cloudlib-uploads-bucket-name

# AWS Secrets Manager Secret ID (loaded automatically via IAM role on EC2)
AWS_BACKEND_SECRET_ID=cloudlib/backend/env

# Note: Do NOT add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here in production.
# The application uses the attached EC2 IAM Role: CloudLib-EC2-Role.

# ------------------------------------------------------------------------------
# FRONTEND / CORS CONFIGURATION
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (Password Recovery)
# ------------------------------------------------------------------------------
# Uses SMPT_ spelling as established in the original codebase
SMPT_SERVICE=gmail
SMPT_MAIL=your_email@gmail.com
SMPT_PASSWORD=your_app_specific_password
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465

# ------------------------------------------------------------------------------
# STRIPE PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
STRIPE_API_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

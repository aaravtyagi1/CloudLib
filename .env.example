# Environment Configuration Template for PostgreSQL & Node.js Backend

PORT=4000

# PostgreSQL Connection String (Amazon RDS / Local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecommerce?schema=public"

# JWT Secret and Expiration
JWT_SECRET=WSO23KLSDF0923JLKSDF89324KJLSDF0923
JWT_EXPIRE=5d

# Cookie Expiration in days
COOKIE_EXPIRE=5

# SMTP Email Configuration (Password Reset)
SMPT_SERVICE=gmail
SMPT_MAIL=your_email@gmail.com
SMPT_PASSWORD=your_app_password
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payment Gateway Configuration
STRIPE_API_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

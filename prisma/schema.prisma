// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  password           String
  avatar             Json      // { public_id: String, url: String }
  role               String    @default("user")
  createdAt          DateTime  @default(now())
  resetPasswordToken String?
  resetPasswordExpire DateTime?

  products           Product[]
  orders             Order[]
  reviews            Review[]

  @@map("users")
}

model Product {
  id           String      @id @default(uuid())
  name         String
  description  String
  price        Float
  ratings      Float       @default(0)
  images       Json        // Array of { public_id: String, url: String }
  category     String
  Stock        Int         @default(1)
  numOfReviews Int         @default(0)
  createdAt    DateTime    @default(now())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviews      Review[]
  orderItems   OrderItem[]

  @@map("products")
}

model Review {
  id        String   @id @default(uuid())
  rating    Float
  comment   String
  name      String
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Order {
  id            String      @id @default(uuid())
  shippingInfo  Json        // { address, city, state, country, pinCode, phoneNo }
  paymentInfo   Json        // { id, status }
  paidAt        DateTime
  itemsPrice    Float       @default(0)
  taxPrice      Float       @default(0)
  shippingPrice Float       @default(0)
  totalPrice    Float       @default(0)
  orderStatus   String      @default("Processing")
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderItems    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  name      String
  price     Float
  quantity  Int
  image     String

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
